# Copy to .env at the repository root. Never put this key in VITE_* variables.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=1
GROQ_MAX_COMPLETION_TOKENS=2048
GROQ_TOP_P=1
GROQ_REASONING_EFFORT=medium
GROQ_TIMEOUT_SECONDS=30

# Structured report drafts use separate settings from streaming investigation.
GROQ_REPORT_TEMPERATURE=0
GROQ_REPORT_MAX_COMPLETION_TOKENS=8192
